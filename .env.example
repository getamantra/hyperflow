NODE_ENV=development
PORT=3334
HOST=localhost

# Generate your own with: node ace generate:key
APP_KEY=

LOG_LEVEL=info

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=hyperflow
DB_PASSWORD=hyperflow
DB_DATABASE=hyperflow

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Set to 1 to enable Redis-backed response caching (experimental, off by default)
ENABLE_CACHE=0

# Base URL this Hyperflow instance is reachable at, used when tasks call back into its own API
HYPERFLOW_URL=http://localhost:3334

# Basic-auth credentials protecting the Swagger UI (/docs)
SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=change-me
